NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side ONLY: used by scripts/sample-data.mjs (corepack pnpm sample:data)
# to create sample users and seed base rows. Never expose it in app code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Display-only receiving account for the manually reviewed Saver Pass flow.
NEXT_PUBLIC_GCASH_ACCOUNT_NAME=LensShare
NEXT_PUBLIC_GCASH_ACCOUNT_NUMBER=09XXXXXXXXX
